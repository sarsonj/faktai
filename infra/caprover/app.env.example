# FaktAI – jedna CapRover appka (CR-0061). Web i API běží na stejné adrese.
# V CapRoveru: Has Persistent Data + Persistent Directory „/data“ (viz doc/nasazeni-caprover.md).
# Container HTTP Port: 3000
NODE_ENV=production
TRUST_PROXY=1

# Veřejná adresa aplikace (odkazy v e-mailu pro reset hesla)
APP_BASE_URL=https://app.example.cz

TZ=Europe/Prague
SESSION_SECRET=replace-with-long-random-secret
SESSION_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=30

# Volitelné SMTP (pokud chybí, reset link je jen v logu)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@fakturai.app

# Registry lookup timeouts
REGISTRY_TIMEOUT_MS=6000
REGISTRY_USER_AGENT=FaktAI/1.0 (+https://app.example.cz)

# XML verze
XML_SCHEMA_DPH_VERSION=current
XML_SCHEMA_KH_VERSION=current

# Data – výchozí hodnoty z Dockerfile, měnit není potřeba:
# DATABASE_URL=file:/data/faktai.db
# ATTACHMENTS_DIR=/data/attachments
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=14

# Jednorázový převod ze staré PostgreSQL databáze – po úspěšném převodu smažte.
# IMPORT_FROM_POSTGRES_URL=postgresql://tappy:supersecret@srv-captain--postgres:5432/tappyfaktur
