API_PORT=4000
# Při vývoji běží web na Vite (proxy /api → API), odkazy v e-mailech míří sem:
APP_BASE_URL=http://localhost:5173
# SQLite – cesta je relativní k apps/api/prisma, tj. apps/api/storage/faktai.db
DATABASE_URL=file:../storage/faktai.db
TZ=Europe/Prague
TRUST_PROXY=0
SESSION_SECRET=change-me
SESSION_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=30
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@tappyfaktur.local
INVOICE_NUMBER_FORMAT=YYYYNNNN
XML_SCHEMA_DPH_VERSION=current
XML_SCHEMA_SH_VERSION=current
XML_SCHEMA_KH_VERSION=current
# Volitelné: zálohy SQLite (v Dockeru /data/backups)
# BACKUP_DIR=./storage/backups
